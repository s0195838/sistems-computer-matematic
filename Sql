-- 1. Category
CREATE TABLE Category (
    id            NUMBER PRIMARY KEY,
    name          VARCHAR2(200) NOT NULL
);

-- 2. Customer
CREATE TABLE Customer (
    id                NUMBER PRIMARY KEY,
    email             VARCHAR2(250) UNIQUE NOT NULL,
    name              VARCHAR2(150) NOT NULL,
    registration_date DATE DEFAULT SYSDATE
);

-- 3. Product (depends on Category)
CREATE TABLE Product (
    id            NUMBER PRIMARY KEY,
    category_id   NUMBER NOT NULL,
    name          VARCHAR2(300) NOT NULL,
    description   CLOB,
    price         NUMBER(10,2) NOT NULL,
    stock         NUMBER DEFAULT 0,
    CONSTRAINT fk_product_category FOREIGN KEY (category_id)
        REFERENCES Category(id)
);

-- 4. Orders (depends on Customer)
CREATE TABLE Orders (
    id              NUMBER PRIMARY KEY,
    customer_id     NUMBER NOT NULL,
    order_date      DATE DEFAULT SYSDATE,
    status          VARCHAR2(50) DEFAULT 'New',
    total_amount    NUMBER(12,2),
    CONSTRAINT fk_order_customer FOREIGN KEY (customer_id)
        REFERENCES Customer(id)
);

-- 5. Cart_Item (depends on Customer, Product and Orders)
-- order_id can be NULL until the order is placed
CREATE TABLE Cart_Item (
    id            NUMBER PRIMARY KEY,
    customer_id   NUMBER NOT NULL,
    product_id    NUMBER NOT NULL,
    order_id      NUMBER,
    quantity      NUMBER DEFAULT 1,
    CONSTRAINT fk_cart_customer FOREIGN KEY (customer_id)
        REFERENCES Customer(id),
    CONSTRAINT fk_cart_product FOREIGN KEY (product_id)
        REFERENCES Product(id),
    CONSTRAINT fk_cart_order FOREIGN KEY (order_id)
        REFERENCES Orders(id)
);
